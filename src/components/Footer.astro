---
import { SITE, NAV } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-white/80">
  <div class="hazard" aria-hidden="true"></div>
  <div class="container-x grid gap-10 py-12 md:grid-cols-3">
    <div>
      <img src="/logo-white.png" alt={SITE.name} class="h-11 w-auto object-contain mb-4" />
      <p class="text-sm font-bold text-copper-400 uppercase tracking-wide">{SITE.valueProp}</p>
      <p class="mt-2 text-sm text-white/70">Chatarrería en {SITE.city} con más de {SITE.yearsOfExperience} años de servicio.</p>
      <div class="mt-4 border-t border-white/10 pt-3 text-sm">
        <p class="text-white"><strong>Atención:</strong> {SITE.contactPerson}</p>
        <p class="mt-1"><a class="text-copper-400 hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>
    <address class="text-sm not-italic">
      <p class="font-bold text-white uppercase tracking-wider text-xs">Ubicación</p>
      <p class="mt-1 text-white font-medium">{SITE.address.street}</p>
      <p>{SITE.city}, {SITE.region}</p>
      <a class="mt-1 inline-block text-copper-400 font-semibold underline" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps</a>
      
      <p class="mt-4 font-bold text-white uppercase tracking-wider text-xs">Teléfonos / WhatsApp</p>
      {SITE.phones.map((p) => (
        <p class="mt-1">
          <a class="hover:text-copper-400 font-medium" href={`https://wa.me/${p.wa}`} target="_blank" rel="noopener noreferrer">
            {p.display} <span class="text-xs text-white/60">({p.label})</span>
          </a>
        </p>
      ))}

      <p class="mt-4 font-bold text-white uppercase tracking-wider text-xs">Horario de atención</p>
      {SITE.hours.map((h) => <p class="mt-0.5">{h.label}: {h.display}</p>)}
    </address>
    <nav aria-label="Pie de página" class="text-sm">
      <p class="font-bold text-white uppercase tracking-wider text-xs">Navegación</p>
      <ul class="mt-2 space-y-2">
        {NAV.map((i) => <li><a class="hover:text-copper-400 transition" href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="border-t border-white/10 py-4 text-center text-xs text-white/60">
    © {year} {SITE.name} ({SITE.alternateName}). Compra y venta de materiales reciclables en {SITE.city}.
  </p>
</footer>
