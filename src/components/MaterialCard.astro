---
import type { Material } from '../data/materials';
import { waLink, quoteMessage } from '../lib/whatsapp';
import { Image } from 'astro:assets';

interface Props { material: Material; level?: 'h2' | 'h3'; variant?: 'full' | 'compact' }
const { material: m, level = 'h3', variant = 'full' } = Astro.props;
const Heading = level;
const compactSymbol = m.symbol.length > 3;
const isCompact = variant === 'compact';

// Personalización metalúrgica por familia de material
const METAL_THEMES: Record<string, {
  tileBg: string;
  tileBorder: string;
  tileText: string;
  cardBorderHover: string;
  tagClass: string;
  accentBar: string;
}> = {
  cobre: {
    tileBg: 'bg-[#2a1306]',
    tileBorder: 'border-amber-600/70',
    tileText: 'text-amber-400',
    cardBorderHover: 'hover:border-amber-500/50',
    tagClass: 'bg-amber-50/90 text-amber-950 border border-amber-200/80',
    accentBar: 'bg-gradient-to-r from-amber-600 via-amber-500 to-amber-400',
  },
  aluminio: {
    tileBg: 'bg-slate-900',
    tileBorder: 'border-slate-400/70',
    tileText: 'text-slate-200',
    cardBorderHover: 'hover:border-slate-400/50',
    tagClass: 'bg-slate-100 text-slate-800 border border-slate-200',
    accentBar: 'bg-gradient-to-r from-slate-500 via-slate-400 to-slate-300',
  },
  'chatarra-hierro-acero': {
    tileBg: 'bg-zinc-900',
    tileBorder: 'border-zinc-500/70',
    tileText: 'text-zinc-200',
    cardBorderHover: 'hover:border-zinc-500/50',
    tagClass: 'bg-zinc-100 text-zinc-800 border border-zinc-200',
    accentBar: 'bg-gradient-to-r from-zinc-600 via-zinc-500 to-zinc-400',
  },
  'bronce-y-radiadores': {
    tileBg: 'bg-[#241a04]',
    tileBorder: 'border-yellow-600/70',
    tileText: 'text-yellow-400',
    cardBorderHover: 'hover:border-yellow-500/50',
    tagClass: 'bg-yellow-50/90 text-yellow-950 border border-yellow-200/80',
    accentBar: 'bg-gradient-to-r from-yellow-600 via-yellow-500 to-yellow-400',
  },
  baterias: {
    tileBg: 'bg-[#251305]',
    tileBorder: 'border-orange-500/70',
    tileText: 'text-orange-400',
    cardBorderHover: 'hover:border-orange-500/50',
    tagClass: 'bg-orange-50/90 text-orange-950 border border-orange-200/80',
    accentBar: 'bg-gradient-to-r from-orange-600 via-orange-500 to-amber-400',
  },
  'plomo-y-antimonio': {
    tileBg: 'bg-cyan-950/40',
    tileBorder: 'border-cyan-600/70',
    tileText: 'text-cyan-300',
    cardBorderHover: 'hover:border-cyan-500/50',
    tagClass: 'bg-cyan-50/90 text-cyan-950 border border-cyan-200/80',
    accentBar: 'bg-gradient-to-r from-cyan-600 via-cyan-500 to-cyan-400',
  },
  electrodomesticos: {
    tileBg: 'bg-sky-950/40',
    tileBorder: 'border-sky-600/70',
    tileText: 'text-sky-300',
    cardBorderHover: 'hover:border-sky-500/50',
    tagClass: 'bg-sky-50/90 text-sky-950 border border-sky-200/80',
    accentBar: 'bg-gradient-to-r from-sky-600 via-sky-500 to-sky-400',
  },
};

const theme = METAL_THEMES[m.slug] ?? {
  tileBg: 'bg-brand-900',
  tileBorder: 'border-brand-800',
  tileText: 'text-copper-500',
  cardBorderHover: 'hover:border-brand-700/50',
  tagClass: 'bg-brand-100 text-brand-900',
  accentBar: 'bg-copper-500',
};
---

<article class:list={[
  'group relative flex h-full flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg',
  isCompact ? 'p-3.5 sm:p-4' : 'p-5',
  theme.cardBorderHover
]}>
  <!-- Barra de acento metalúrgico superior -->
  <div class:list={['absolute left-0 top-0 h-1.5 w-full z-10', theme.accentBar]}></div>

  {m.image ? (
    <a href={`/materiales/${m.slug}/`} class:list={[
      'relative block overflow-hidden bg-brand-950',
      isCompact ? '-mx-3.5 -mt-3.5 sm:-mx-4 sm:-mt-4 mb-3 aspect-[4/3]' : '-mx-5 -mt-5 mb-4 aspect-[16/10]'
    ]}>
      <Image
        src={m.image}
        alt={m.imageAlt || `Compra de ${m.name} en Bucaramanga`}
        widths={[320, 480, 640]}
        sizes={isCompact ? '(min-width: 1024px) 25vw, 50vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
      
      <!-- Ficha metalúrgica flotante sobre la foto -->
      <div class:list={[
        'absolute flex flex-col justify-between rounded-lg border shadow-md backdrop-blur-sm',
        isCompact ? 'bottom-2 left-2 h-10 w-12 p-1' : 'bottom-3 left-3 h-12 w-14 p-1.5',
        theme.tileBg, theme.tileBorder, theme.tileText
      ]} aria-hidden="true">
        <span class="text-[9px] font-bold leading-none tracking-wider opacity-80">{m.number}</span>
        <span class:list={['font-display font-extrabold leading-none', compactSymbol ? 'text-xs sm:text-sm' : isCompact ? 'text-lg' : 'text-xl']}>{m.symbol}</span>
      </div>
    </a>
    <div>
      <Heading class:list={[isCompact ? 'text-lg sm:text-xl leading-tight' : 'text-2xl', 'text-brand-900']}>
        <a href={`/materiales/${m.slug}/`} class="hover:text-brand-700 transition">{isCompact ? (m.shortName ?? m.name) : m.name}</a>
      </Heading>
      <p class:list={['mt-1 text-ink/80 leading-snug', isCompact ? 'text-xs sm:text-sm line-clamp-2' : 'text-sm']}>{m.short}</p>
    </div>
  ) : (
    <div class="flex items-start gap-4 pt-1">
      <!-- Ficha con identidad metalúrgica -->
      <div class:list={['relative flex h-20 w-20 flex-none flex-col justify-between rounded-lg border p-2 shadow-inner', theme.tileBg, theme.tileBorder, theme.tileText]} aria-hidden="true">
        <span class="text-[10px] font-bold leading-none tracking-wider opacity-80">{m.number}</span>
        <span class:list={['font-display font-extrabold leading-none', compactSymbol ? 'text-xl' : 'text-4xl']}>{m.symbol}</span>
      </div>
      <div>
        <Heading class="text-2xl text-brand-900">
          <a href={`/materiales/${m.slug}/`} class="hover:text-brand-700 transition">{m.name}</a>
        </Heading>
        <p class="mt-1 text-sm text-ink/80 leading-snug">{m.short}</p>
      </div>
    </div>
  )}

  {!isCompact && (
    <ul class="mt-4 flex flex-wrap gap-1.5 text-xs">
      {m.items.slice(0, 4).map((i) => (
        <li class:list={['rounded-md px-2.5 py-1 font-medium', theme.tagClass]}>
          {i}
        </li>
      ))}
    </ul>
  )}

  <!-- Bloque de conversión con llamada única y directa -->
  <div class:list={['mt-auto', isCompact ? 'pt-3' : 'pt-5']}>
    <a
      class:list={[
        'btn btn-primary w-full font-extrabold shadow-sm hover:shadow-md transition text-center',
        isCompact ? 'py-2 px-3 text-xs sm:text-sm' : 'py-3 px-4 text-base'
      ]}
      href={waLink(quoteMessage({ material: m.name }))}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Cotizar ${m.name} por WhatsApp (se abre en una pestaña nueva)`}
    >
      <svg class:list={['flex-none', isCompact ? 'h-4 w-4' : 'h-5 w-5']} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2z" />
        <path fill="var(--color-copper-500)" d="M9 7.6c-.3 0-.6.1-.8.4-.5.6-.9 1.3-.5 2.4.6 1.7 2.2 3.5 4 4.4 1.3.6 2 .5 2.7.1.3-.2.7-.6.8-1 .1-.3 0-.5-.2-.6l-1.5-.8c-.2-.1-.4 0-.5.1l-.6.7c-.1.1-.3.2-.5.1-.9-.4-1.9-1.3-2.4-2.2-.1-.2-.1-.4 0-.5l.5-.6c.1-.1.1-.3 0-.5l-.7-1.6c-.1-.2-.3-.3-.5-.3z" />
      </svg>
      <span class="whitespace-nowrap">{isCompact ? 'Cotizar' : `Cotizar ${m.shortName ?? m.name}`}</span>
    </a>
  </div>
</article>
