---
import { NAV, SITE } from '../data/site';
import { waLink, priceListMessage } from '../lib/whatsapp';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-brand-950/95 text-white backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 py-1 group" aria-label={`${SITE.name}, ir al inicio`}>
      <img src="/logo-white.png" alt={SITE.name} class="h-9 sm:h-11 w-auto object-contain transition group-hover:scale-105" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-7 md:flex">
      {NAV.map((i) => <a href={i.href} aria-current={current(i.href)} class="text-sm font-semibold hover:text-copper-400 aria-[current=page]:text-copper-400 transition">{i.label}</a>)}
    </nav>

    <div class="flex items-center gap-2.5">
      <a href={waLink(priceListMessage())} target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-3.5 !py-2 text-sm font-extrabold whitespace-nowrap">
        <span>Cotizar</span><span class="hidden sm:inline"> mi material</span>
      </a>
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-lg border border-white/30 px-3 py-2 text-sm font-bold bg-white/5 hover:bg-white/10 transition">Menú</summary>
        <nav aria-label="Menú móvil" class="absolute right-0 mt-2 w-56 rounded-lg bg-brand-900 border border-brand-800 p-2 shadow-xl">
          {NAV.map((i) => <a href={i.href} class="block rounded px-3 py-3 font-semibold hover:bg-white/10">{i.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
