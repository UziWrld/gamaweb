---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { Image } from 'astro:assets';
import fachadaGama from '../assets/bodega/fachada-gama.jpg';
import { PAGES } from '../data/seo';
import { SITE } from '../data/site';
import { waLink, generalMessage } from '../lib/whatsapp';
import { businessSchema, breadcrumbSchema } from '../lib/schema';
const siteUrl = Astro.site!.origin;
---

<Layout {...PAGES.contacto} jsonLd={[businessSchema(siteUrl), breadcrumbSchema(siteUrl, [{ name: 'Contacto', path: '/contacto/' }])]}>
  <section class="hero-bg text-white">
    <div class="container-x py-14 sm:py-20">
      <h1 class="max-w-4xl text-5xl sm:text-6xl">Chatarrería Gama Metales: ubicación, horarios y contacto en <span class="text-copper-500">Bucaramanga</span></h1>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>

  <div class="container-x grid gap-10 py-12 lg:grid-cols-2">
    <div>
      <h2 class="text-4xl text-brand-900">Dónde encontrarnos</h2>
      <address class="mt-4 text-lg not-italic">
        <p class="font-bold text-brand-900">{SITE.address.street}</p>
        <p class="text-ink/80">{SITE.city}, {SITE.region}</p>
      </address>

      <!-- Botón directo de navegación -->
      <a
        class="btn btn-primary mt-4 flex w-full sm:w-auto sm:inline-flex items-center justify-center gap-2 text-base font-bold shadow-sm"
        href={SITE.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir ruta hacia Chatarrería Gama Metales en Google Maps"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="3 11 22 2 13 21 11 13 3 11" />
        </svg>
        <span>Abrir ruta</span>
      </a>

      <!-- Tarjetas visuales: Fachada y Mapa de Google -->
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <!-- Fachada real del negocio -->
        <div class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm flex flex-col">
          <Image
            src={fachadaGama}
            alt={`Fachada exterior de Chatarrería Gama en ${SITE.address.street}, Bucaramanga`}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="w-full h-auto aspect-[4/5] object-cover flex-1"
            loading="eager"
          />
          <div class="p-3 bg-brand-900 text-white flex items-center justify-between gap-2 text-xs font-semibold min-h-[44px]">
            <span>Ingreso bodega</span>
            <span class="text-copper-400 whitespace-nowrap">Descargue interior</span>
          </div>
        </div>

        <!-- Mapa embebido de Google Maps -->
        <div class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm flex flex-col">
          <iframe
            src="https://www.google.com/maps?q=Carrera+11+%23+23-35,+Bucaramanga&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="aspect-[4/3] w-full flex-1 min-h-[220px]"
            title="Ubicación de Chatarrería Gama Metales en Google Maps"
          ></iframe>
          <div class="p-3 bg-brand-900 text-white flex items-center justify-between gap-2 text-xs font-semibold min-h-[44px]">
            <span>Mapa en Google</span>
            <span class="text-copper-400 whitespace-nowrap">Cra 11 # 23-35</span>
          </div>
        </div>
      </div>

      <!-- Aclaración de descargue bajo techo -->
      <div class="mt-4 rounded-xl border border-brand-200 bg-brand-100/60 p-4 text-xs text-brand-900 flex items-start gap-3">
        <svg class="h-5 w-5 text-copper-600 flex-none mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
          <path d="M15 18H9"/>
          <path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10"/>
          <circle cx="7" cy="18" r="2"/>
          <circle cx="17" cy="18" r="2"/>
        </svg>
        <div>
          <p class="font-bold text-sm text-brand-950">Descargue directo dentro de la bodega</p>
          <p class="mt-1 text-ink/85 leading-relaxed">Portón amplio para ingresar tu camioneta, camión o carro particular. Descargas bajo techo con total comodidad y seguridad, sin trancón ni problemas de parqueo en la calle.</p>
        </div>
      </div>



      <h2 class="mt-10 text-4xl text-brand-900">Horario de atención</h2>
      <table class="mt-4 w-full max-w-md text-left">
        <caption class="sr-only">Horario de atención de Gama Metales</caption>
        <tbody>
          {SITE.hours.map((h) => <tr class="border-b border-brand-100"><th scope="row" class="py-2 pr-4 font-semibold whitespace-nowrap">{h.label}</th><td class="py-2">{h.display}</td></tr>)}
        </tbody>
      </table>
      <p class="mt-2 text-sm text-ink/70">{SITE.closedNote}</p>

      <h2 class="mt-10 text-4xl text-brand-900">WhatsApp y llamadas</h2>
      <ul class="mt-4 grid gap-3">
        {SITE.phones.map((p) => (
          <li class="flex flex-wrap items-center gap-3">
            <a class="btn btn-wa" href={waLink(generalMessage(), p.wa)} target="_blank" rel="noopener noreferrer">WhatsApp {p.display}</a>
            <a class="font-bold text-brand-700 underline" href={`tel:${p.e164}`}>Llamar</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:sticky lg:top-24 lg:self-start"><QuoteForm /></div>
  </div>
</Layout>
