---
import Layout from '../layouts/Layout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import FaqList from '../components/FaqList.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { PAGES } from '../data/seo';
import { MATERIALS } from '../data/materials';
import { HOME_FAQS } from '../data/faqs';
import { REVIEWS } from '../data/reviews';
import { GALLERY } from '../data/gallery';
import { waLink, generalMessage, arrivalMessage } from '../lib/whatsapp';
import { businessSchema, websiteSchema, faqSchema } from '../lib/schema';

const siteUrl = Astro.site!.origin;
const ticker = ['Cobre de primera', 'Aluminio perfil', 'Chatarra ferrosa', 'Baterías 4D/8D', 'Bronce y llaves', 'Radiadores', 'Acero inoxidable', 'Rines de aluminio', 'Neveras viejas', 'Varilla de obra'];
const interiorPhoto = GALLERY[1];
---

<Layout {...PAGES.home} jsonLd={[websiteSchema(siteUrl), businessSchema(siteUrl), faqSchema(HOME_FAQS)]}>
  <!-- HERO -->
  <section class="hero-bg text-white">
    <div class="container-x grid gap-8 sm:gap-10 py-8 sm:py-16 lg:py-20 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="text-xs sm:text-sm font-bold uppercase tracking-widest text-copper-400 mb-3">
          Cra 11 # 23-35 · Bucaramanga
        </p>
        <h1 class="font-display font-extrabold uppercase text-3xl sm:text-5xl lg:text-6xl leading-[1.05] sm:leading-[0.95] tracking-tight">
          Chatarrería en Bucaramanga <span class="text-copper-400 block sm:inline sm:ml-2">a precio del día</span>
        </h1>
        <p class="mt-4 max-w-xl text-base sm:text-lg text-white/85 leading-relaxed">
          Compramos cobre, aluminio, hierro, bronce, baterías y electrodomésticos. <strong>Pesaje a la vista</strong> y pago 100 % en efectivo al instante.
        </p>
        
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a class="btn btn-wa text-sm sm:text-base font-extrabold py-2.5 px-5 shadow-lg shadow-wa/20 transition hover:scale-[1.02] active:scale-[0.98]" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">
            <svg class="h-4 w-4 sm:h-5 sm:w-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2z" />
              <path fill="#25d366" d="M9 7.6c-.3 0-.6.1-.8.4-.5.6-.9 1.3-.5 2.4.6 1.7 2.2 3.5 4 4.4 1.3.6 2 .5 2.7.1.3-.2.7-.6.8-1 .1-.3 0-.5-.2-.6l-1.5-.8c-.2-.1-.4 0-.5.1l-.6.7c-.1.1-.3.2-.5.1-.9-.4-1.9-1.3-2.4-2.2-.1-.2-.1-.4 0-.5l.5-.6c.1-.1.1-.3 0-.5l-.7-1.6c-.1-.2-.3-.3-.5-.3z" />
            </svg>
            <span>Cotizar por WhatsApp</span>
          </a>
          <a class="btn btn-ghost text-xs sm:text-sm font-bold py-2.5 px-4 border-white/20 bg-white/5 hover:bg-white/10 transition flex items-center gap-1.5" href="#ubicacion">
            <svg class="h-4 w-4 text-copper-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Cómo llegar</span>
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-y-2 gap-x-5 text-xs sm:text-sm font-semibold text-white/75">
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> +{SITE.yearsOfExperience} años en Bucaramanga</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> Precios competitivos del día</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> Recolección desde {SITE.pickup.minKg} kg</span>
        </div>
      </div>

      <!-- Fotografía real de la fachada enfocada en el letrero y portón -->
      <div class="mt-4 lg:mt-0 flex justify-center">
        <Image
          src={GALLERY[0].src}
          alt="Fachada e ingreso de Chatarrería Gama Metales en Carrera 11 # 23-35 Bucaramanga"
          widths={[400, 750, 1000]}
          sizes="(min-width: 1024px) 45vw, (min-width: 640px) 75vw, 100vw"
          class="w-full max-w-[420px] lg:max-w-none aspect-[5/4] object-cover object-[50%_80%] rounded-2xl shadow-2xl"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- Cinta de materiales animada continua -->
    <div class="overflow-hidden border-y border-white/10 bg-brand-900 py-3.5 select-none" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="flex items-center shrink-0 font-display text-lg sm:text-2xl font-bold uppercase tracking-widest text-white/85">
            {ticker.map((t) => (
              <span class="inline-flex items-center px-4 sm:px-6">
                <span>{t}</span>
                <span class="text-copper-500 ml-4 sm:ml-6 text-sm">◆</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="hazard" aria-hidden="true"></div>

    <style is:inline>
      @keyframes ticker-slide {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
      }
      .ticker-track {
        display: flex !important;
        width: max-content !important;
        will-change: transform;
        animation: ticker-slide 42s linear infinite !important;
      }
      .ticker-track:hover {
        animation-play-state: paused !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .ticker-track {
          animation: none !important;
        }
      }
    </style>
  </section>

  <!-- BANDA COMPACTA DE GARANTÍAS -->
  <section class="border-b border-slate-200/80 bg-white py-8" aria-label="Garantías de servicio">
    <div class="container-x grid gap-5 md:grid-cols-3">
      <div class="flex items-start gap-3.5">
        <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-brand-100 text-brand-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="M7 21h10"/>
            <path d="M12 3v18"/>
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
          </svg>
        </div>
        <div>
          <p class="font-display text-lg font-extrabold uppercase leading-[0.95] tracking-tight text-brand-900">Báscula electrónica a la vista</p>
          <p class="mt-0.5 text-sm text-ink/75">Verificas cada kilo en pantalla durante el pesaje.</p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-brand-100 text-brand-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="12" x="2" y="6" rx="2"/>
            <circle cx="12" cy="12" r="2"/>
            <path d="M6 12h.01M18 12h.01"/>
          </svg>
        </div>
        <div>
          <p class="font-display text-lg font-extrabold uppercase leading-[0.95] tracking-tight text-brand-900">Efectivo al instante</p>
          <p class="mt-0.5 text-sm text-ink/75">Liquidación en efectivo al terminar el pesaje (empresas: consulta formas de pago).</p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-brand-100 text-brand-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
            <path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10"/>
            <circle cx="7" cy="18" r="2"/>
            <circle cx="17" cy="18" r="2"/>
          </svg>
        </div>
        <div>
          <p class="font-display text-lg font-extrabold uppercase leading-[0.95] tracking-tight text-brand-900">Recolección desde {SITE.pickup.minKg} kg</p>
          <p class="mt-0.5 text-sm text-ink/75">
            {SITE.pickup.noFreightNote} <a href="/recoleccion-de-chatarra/" class="font-semibold text-brand-700 hover:underline whitespace-nowrap">Ver cobertura →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TODOS LOS MATERIALES (grid compacto 2x4 móvil / 4x2 escritorio) -->
  <section class="container-x py-12" aria-labelledby="materiales">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 id="materiales" class="text-4xl text-brand-900 sm:text-5xl">Qué metales compramos en Bucaramanga</h2>
        <p class="mt-2 text-ink/80">Toca cualquier material para ver cómo prepararlo o cotízalo directo por WhatsApp.</p>
      </div>
      <a class="btn btn-outline text-sm font-bold whitespace-nowrap" href="/materiales/">
        Ver detalle completo →
      </a>
    </div>

    <div class="mt-7 grid grid-cols-2 gap-3.5 sm:gap-5 lg:grid-cols-4">
      {MATERIALS.map((m) => <MaterialCard material={m} level="h3" variant="compact" />)}

      <article class="flex h-full flex-col justify-between rounded-2xl border border-brand-800 border-t-4 border-t-copper-500 bg-brand-900 p-3.5 sm:p-4 text-white shadow-sm">
        <div>
          <p class="text-[11px] font-extrabold uppercase tracking-widest text-copper-400">Otros metales</p>
          <h3 class="mt-1.5 text-lg sm:text-xl leading-tight text-white">¿No ves tu material?</h3>
          <p class="mt-2 text-xs sm:text-sm text-white/75 leading-snug">
            Envíanos una foto por WhatsApp y te confirmamos recepción y tarifa hoy.
          </p>
          <ul class="mt-3 space-y-1 text-xs text-white/85">
            <li class="flex items-center gap-1.5"><span class="text-copper-400 font-bold" aria-hidden="true">✓</span> Motores eléctricos</li>
            <li class="flex items-center gap-1.5"><span class="text-copper-400 font-bold" aria-hidden="true">✓</span> Acero inoxidable</li>
            <li class="flex items-center gap-1.5"><span class="text-copper-400 font-bold" aria-hidden="true">✓</span> Cableado y lotes mixtos</li>
          </ul>
        </div>
        <div class="mt-auto pt-3">
          <a
            class="btn btn-wa w-full py-2 px-3 text-xs sm:text-sm font-extrabold text-center"
            href={waLink(generalMessage())}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2z" />
              <path fill="#25d366" d="M9 7.6c-.3 0-.6.1-.8.4-.5.6-.9 1.3-.5 2.4.6 1.7 2.2 3.5 4 4.4 1.3.6 2 .5 2.7.1.3-.2.7-.6.8-1 .1-.3 0-.5-.2-.6l-1.5-.8c-.2-.1-.4 0-.5.1l-.6.7c-.1.1-.3.2-.5.1-.9-.4-1.9-1.3-2.4-2.2-.1-.2-.1-.4 0-.5l.5-.6c.1-.1.1-.3 0-.5l-.7-1.6c-.1-.2-.3-.3-.5-.3z" />
            </svg>
            <span class="whitespace-nowrap">Enviar foto</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- BODEGA REAL + ENLACE B2B -->
  {interiorPhoto && (
    <section class="container-x pb-12" aria-labelledby="bodega">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-6">
            <div class="overflow-hidden rounded-2xl border border-brand-100 bg-brand-900 shadow-sm flex flex-col">
              <Image
                src={interiorPhoto.src}
                alt={interiorPhoto.alt}
                widths={[480, 800]}
                sizes="(min-width: 1024px) 45vw, 100vw"
                class="w-full h-auto aspect-[4/3] object-cover"
                loading="lazy"
              />
              <div class="p-3 bg-brand-900 text-white text-xs font-semibold flex flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between">
                <span class="text-copper-400 font-bold">{interiorPhoto.label}</span>
                <span class="text-white/70 text-[11px]">{SITE.address.street}</span>
              </div>
            </div>
          </div>
          <div class="lg:col-span-6">
            <p class="text-xs font-extrabold uppercase tracking-widest text-brand-700">
              Instalaciones en Bucaramanga
            </p>
            <h2 id="bodega" class="mt-2 text-3xl sm:text-4xl text-brand-900">Nuestra bodega en Carrera 11 # 23-35</h2>
            <p class="mt-3 text-sm sm:text-base text-ink/80 leading-relaxed">
              Patio amplio y cubierto para descargue cómodo de metales, chatarra y baterías sin congestión en la vía.
            </p>
            <ul class="mt-5 space-y-2.5 text-sm font-medium text-ink/90">
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Portón amplio para descargue bajo techo:</strong> Ingreso cómodo de camionetas, camiones y furgones protegidos de la lluvia.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Atención en jornada continua:</strong> Lunes a viernes de 7:00 a. m. a 5:30 p. m. y sábados de 7:00 a. m. a 1:30 p. m.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Atención a talleres y empresas:</strong> Excedentes de obra, maquinaria y retales. <a href="/empresas/" class="font-bold text-brand-700 hover:underline whitespace-nowrap">Ver servicio para empresas →</a></span>
              </li>
            </ul>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                class="btn btn-primary text-sm font-extrabold"
                href={SITE.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Cómo llegar a la bodega</span>
              </a>
              <a class="btn btn-outline text-sm font-bold" href={waLink(arrivalMessage())} target="_blank" rel="noopener noreferrer">
                <span>Avisar llegada por WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- RESEÑAS (solo reseñas reales de Google) -->
  {REVIEWS.length > 0 && (
    <section class="bg-brand-50 border-y border-slate-200/80 py-14" aria-labelledby="resenas">
      <div class="container-x">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-stretch">
          <!-- Enlace a reseñas en Google sin usar logo de marca ni cifras fijas que caducan -->
          <div class="lg:col-span-4 flex flex-col justify-between rounded-2xl bg-brand-950 p-7 text-white border-t-4 border-t-copper-500 shadow-lg">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-widest text-copper-400">
                Reseñas en Google
              </p>
              <h2 id="resenas" class="mt-3 text-3xl sm:text-4xl text-white">Opiniones de quienes ya vendieron aquí</h2>
              <p class="mt-4 text-sm text-white/75 leading-relaxed">
                Lee todas las reseñas actualizadas en nuestra ficha de Google Maps o comparte tu experiencia después de visitarnos.
              </p>
              <p class="mt-4 border-t border-white/10 pt-4 text-xs text-white/65">
                {SITE.name} · {SITE.address.street}, {SITE.city}
              </p>
            </div>

            {SITE.gbpUrl && (
              <a class="btn btn-primary mt-6 w-full text-sm font-extrabold" href={SITE.gbpUrl} target="_blank" rel="noopener noreferrer">
                Ver reseñas en Google
              </a>
            )}
          </div>

          <!-- Testimonios reales -->
          <div class="lg:col-span-8 flex flex-col justify-between gap-5">
            <div class="grid gap-5 sm:grid-cols-2 flex-1">
              {REVIEWS.map((r) => (
                <figure class="flex flex-col justify-between rounded-2xl border border-slate-200 border-l-4 border-l-copper-500 bg-white p-6 shadow-sm">
                  <div>
                    <div class="flex items-center justify-between gap-3">
                      <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-brand-900 font-display text-xl font-extrabold text-copper-400" aria-hidden="true">
                          {r.author.charAt(0).toUpperCase()}
                        </div>
                        <div>
                          <p class="text-sm font-bold text-brand-950 leading-tight">{r.author}</p>
                          <p class="text-xs text-ink/60">Opinión en Google</p>
                        </div>
                      </div>
                      <span class="text-sm tracking-wider text-copper-500" aria-label={`${r.rating} de 5 estrellas`}>
                        {'★'.repeat(r.rating)}
                      </span>
                    </div>

                    <blockquote class="mt-5 text-lg font-medium text-brand-950 leading-relaxed">
                      “{r.text}”
                    </blockquote>
                  </div>

                  <figcaption class="mt-5 border-t border-slate-100 pt-3 text-xs font-medium text-ink/60 flex items-center justify-between">
                    <span>{r.date ?? 'Google Maps'}</span>
                    <span class="font-semibold text-brand-700">5,0 ★</span>
                  </figcaption>
                </figure>
              ))}
            </div>

            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm">
              <p class="text-ink/80">
                ¿Ya vendiste material con nosotros? Consulta más opiniones o deja tu calificación en nuestra ficha.
              </p>
              {SITE.gbpUrl && (
                <a class="font-bold text-brand-700 hover:underline whitespace-nowrap" href={SITE.gbpUrl} target="_blank" rel="noopener noreferrer">
                  Abrir ficha en Google →
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- UBICACIÓN + FAQ -->
  <section class="container-x grid gap-10 py-14 lg:grid-cols-2" aria-labelledby="ubicacion">
    <div>
      <h2 id="ubicacion" class="text-4xl text-brand-900 sm:text-5xl">Dónde estamos en Bucaramanga</h2>
      <address class="mt-4 not-italic text-lg">
        <p class="font-bold text-brand-900">{SITE.address.street}</p>
        <p class="text-ink/80">{SITE.city}, {SITE.region}</p>
        <div class="mt-4 border-t border-brand-100 pt-3 text-sm">
          <p class="font-bold text-brand-900">Horario de atención:</p>
          {SITE.hours.map((h) => <p class="mt-0.5 text-ink/80">{h.label}: {h.display}</p>)}
          <p class="mt-1 text-xs text-ink/60">{SITE.closedNote}</p>
        </div>
      </address>
      <!-- Mapa embebido de Google Maps -->
      <div class="mt-5 overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
        <iframe
          src="https://www.google.com/maps?q=Carrera+11+%23+23-35,+Bucaramanga&output=embed"
          width="100%"
          height="220"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-56"
          title="Ubicación de Chatarrería Gama Metales en Google Maps"
        ></iframe>
      </div>

      <!-- Botón directo de navegación -->
      <a
        class="btn btn-primary mt-5 flex w-full sm:w-auto sm:inline-flex items-center justify-center gap-2 text-base font-bold shadow-sm"
        href={SITE.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir ruta hacia Chatarrería Gama Metales en Google Maps"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="3 11 22 2 13 21 11 13 3 11" />
        </svg>
        <span>Abrir ruta</span>
      </a>
    </div>
    <div>
      <h2 class="text-4xl text-brand-900 sm:text-5xl">Preguntas frecuentes</h2>
      <div class="mt-6"><FaqList faqs={HOME_FAQS} /></div>
    </div>
  </section>
</Layout>
