---
import Layout from '../layouts/Layout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import FaqList from '../components/FaqList.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { PAGES } from '../data/seo';
import { MATERIALS } from '../data/materials';
import { HOME_FAQS } from '../data/faqs';
import { REVIEWS } from '../data/reviews';
import { GALLERY } from '../data/gallery';
import { waLink, priceListMessage, generalMessage } from '../lib/whatsapp';
import { businessSchema, websiteSchema, faqSchema } from '../lib/schema';

const siteUrl = Astro.site!.origin;
const ticker = ['Cobre de primera', 'Aluminio perfil', 'Chatarra ferrosa', 'Baterías 4D/8D', 'Bronce y llaves', 'Radiadores', 'Acero inoxidable', 'Rines de aluminio', 'Neveras viejas', 'Varilla de obra'];

const clientSegments = [
  {
    title: 'Hogares y particulares',
    desc: 'Neveras, lavadoras, rejas, marcos y cualquier chatarra acumulada en el patio o garaje. Despeja espacio y recibe dinero de inmediato.',
    iconKey: 'home',
  },
  {
    title: 'Plomeros y electricistas',
    desc: 'Los mejores precios del kilo en tubería de cobre, cable pelado, cable encauchetado, grifería y llaves de bronce. Pago al instante.',
    iconKey: 'tools',
  },
  {
    title: 'Talleres mecánicos y montallantas',
    desc: 'Baterías usadas de carro y camión (N40, 4D, 8D), rines de aluminio, radiadores, culatas y discos de freno.',
    iconKey: 'workshop',
  },
  {
    title: 'Constructoras y empresas',
    desc: 'Excedentes metálicos de obras, perfiles, vigas, varilla y maquinaria dada de baja con recolección y logística de cargue incluida.',
    iconKey: 'building',
  },
];
---

<Layout {...PAGES.home} jsonLd={[websiteSchema(siteUrl), businessSchema(siteUrl), faqSchema(HOME_FAQS)]}>
  <!-- HERO -->
  <section class="hero-bg text-white">
    <div class="container-x grid gap-10 py-10 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-copper-500/30 bg-copper-500/10 px-3.5 py-1 text-xs font-bold text-copper-400 backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-copper-400"></span>
          <span>+{SITE.yearsOfExperience} años en Bucaramanga · Pesaje exacto</span>
        </div>
        <h1 class="font-display font-extrabold uppercase text-3xl sm:text-5xl lg:text-6xl leading-[1.05] sm:leading-[0.95] tracking-tight">
          Chatarrería en Bucaramanga <span class="text-copper-400 block sm:inline sm:ml-2">al mejor precio</span>
        </h1>
        <p class="mt-4 max-w-xl text-base sm:text-lg text-white/85 leading-relaxed">
          Compramos cobre, aluminio, hierro, bronce, baterías y electrodomésticos. <strong>Pesaje transparente a la vista</strong> y pago en efectivo al instante.
        </p>
        
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a class="btn btn-wa !rounded-full text-sm sm:text-base font-extrabold py-2.5 px-5 shadow-lg shadow-wa/20 transition hover:scale-[1.02] active:scale-[0.98]" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">
            <svg class="h-4 w-4 sm:h-5 sm:w-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2z" />
              <path fill="#22c55e" d="M9 7.6c-.3 0-.6.1-.8.4-.5.6-.9 1.3-.5 2.4.6 1.7 2.2 3.5 4 4.4 1.3.6 2 .5 2.7.1.3-.2.7-.6.8-1 .1-.3 0-.5-.2-.6l-1.5-.8c-.2-.1-.4 0-.5.1l-.6.7c-.1.1-.3.2-.5.1-.9-.4-1.9-1.3-2.4-2.2-.1-.2-.1-.4 0-.5l.5-.6c.1-.1.1-.3 0-.5l-.7-1.6c-.1-.2-.3-.3-.5-.3z" />
            </svg>
            <span>Cotizar por WhatsApp</span>
          </a>
          <a class="btn btn-ghost !rounded-full text-xs sm:text-sm font-bold py-2.5 px-4 border-white/20 bg-white/5 hover:bg-white/10 transition flex items-center gap-1.5" href="#ubicacion">
            <svg class="h-4 w-4 text-copper-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Cómo llegar</span>
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-y-2 gap-x-5 text-xs sm:text-sm font-semibold text-white/75">
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> Báscula a la vista</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> Efectivo al instante</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-400 font-bold">✓</span> Precios del día</span>
        </div>
      </div>

      <!-- Tarjeta de cotización en columna derecha para pantallas grandes (en móvil se oculta para no saturar) -->
      <aside class="hidden lg:block rotate-1 rounded-2xl border-4 border-copper-500 bg-brand-900/95 p-6 text-white shadow-2xl" aria-label="Cotización de material">
        <p class="text-xs font-extrabold uppercase tracking-widest text-copper-400">Venta directa de material</p>
        <p class="mt-1 font-display text-4xl font-extrabold uppercase text-white">¿Tienes material para vender?</p>
        <p class="mt-2 text-sm text-white/80">Indícanos qué metal tienes, peso estimado y fotos para darte la cotización exacta del kilo hoy.</p>
        <a class="btn btn-primary mt-5 w-full text-base font-extrabold text-center py-3.5" href={waLink(priceListMessage())} target="_blank" rel="noopener noreferrer">Cotizar mi material por WhatsApp</a>
        <p class="mt-3 text-center text-xs text-white/60">Pago en efectivo al instante · Lunes a sábado</p>
      </aside>
    </div>

    <!-- Cinta de materiales animada continua -->
    <div class="overflow-hidden border-y border-white/10 bg-brand-900 py-3.5 select-none" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="flex items-center shrink-0 font-display text-lg sm:text-2xl font-bold uppercase tracking-widest text-white/85">
            {ticker.map((t) => (
              <span class="inline-flex items-center px-4 sm:px-6">
                <span>{t}</span>
                <span class="text-copper-500 ml-4 sm:ml-6 text-sm">◆</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="hazard" aria-hidden="true"></div>

    <style is:inline>
      @keyframes ticker-slide {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
      }
      .ticker-track {
        display: flex !important;
        width: max-content !important;
        will-change: transform;
        animation: ticker-slide 26s linear infinite !important;
      }
      .ticker-track:hover {
        animation-play-state: paused !important;
      }
    </style>
  </section>

  <!-- PILARES DE CONFIANZA -->
  <section class="container-x py-12" aria-labelledby="garantias">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 id="garantias" class="text-3xl sm:text-4xl text-brand-900">Por qué vender tu material en Gama Metales</h2>
      <p class="mt-2 text-ink/75">Cero enredos, peso justo y la plata en tu mano al instante.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-copper-500 mb-5">
          <svg class="h-6 w-6 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="M7 21h10"/>
            <path d="M12 3v18"/>
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
          </svg>
        </div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Báscula exacta y a la vista</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          Pesamos cada kilo frente a ti de forma totalmente transparente en nuestra bodega o en el punto de recolección. Cero descuentos raros ni dudas sobre tu peso.
        </p>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-copper-500 mb-5">
          <svg class="h-6 w-6 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="12" x="2" y="6" rx="2"/>
            <circle cx="12" cy="12" r="2"/>
            <path d="M6 12h.01M18 12h.01"/>
          </svg>
        </div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Efectivo al instante</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          Plata en mano en cuanto terminamos de pesar: te pagamos en efectivo de inmediato en el acto, sin esperas ni demoras.
        </p>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-copper-500 mb-5">
          <svg class="h-6 w-6 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
            <path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10"/>
            <circle cx="7" cy="18" r="2"/>
            <circle cx="17" cy="18" r="2"/>
          </svg>
        </div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Recolección a domicilio (+300 kg)</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          No te compliques cargando material pesado. Si tienes 300 kg o más en tu casa, taller u obra en Bucaramanga y el área metropolitana, vamos por él sin costo de flete (según tipo y volumen de material).
        </p>
      </div>
    </div>
  </section>

  <!-- SEGMENTOS DE CLIENTE -->
  <section class="bg-brand-900 py-14 text-white" aria-labelledby="clientes">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="clientes" class="text-3xl sm:text-5xl">Soluciones a tu medida</h2>
        <p class="mt-3 text-white/80">Atendemos desde pequeñas entregas de hogar hasta grandes volúmenes industriales.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {clientSegments.map((c) => (
          <div class="rounded-xl border border-white/15 bg-white/5 p-6 transition hover:bg-white/10">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-copper-400 mb-4">
              {c.iconKey === 'home' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              )}
              {c.iconKey === 'tools' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              )}
              {c.iconKey === 'workshop' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
              )}
              {c.iconKey === 'building' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/>
                  <path d="M9 22v-4h6v4"/>
                  <path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"/>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold uppercase font-display text-copper-400">{c.title}</h3>
            <p class="mt-2 text-sm text-white/80 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MATERIALES -->
  <section class="container-x py-14" aria-labelledby="materiales">
    <div class="max-w-2xl">
      <h2 id="materiales" class="text-4xl text-brand-900 sm:text-5xl">Qué metales compramos en Bucaramanga</h2>
      <p class="mt-3 text-ink/80">Compramos todo tipo de metales y chatarra. Si tienes dudas con algún material específico, envíanos una foto por WhatsApp y te lo confirmamos en minutos.</p>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {MATERIALS.map((m) => <MaterialCard material={m} level="h3" />)}
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="bg-brand-50 border-y border-brand-100 py-14" aria-labelledby="como">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="como" class="text-4xl text-brand-900 sm:text-5xl">Cómo vender tu chatarra en 3 pasos sencillos</h2>
        <p class="mt-2 text-ink/75">Rápido, transparente y sin complicaciones.</p>
      </div>
      <ol class="grid gap-5 md:grid-cols-3">
        {[
          ['1', 'Escríbenos por WhatsApp', 'Cuéntanos qué metal tienes, el peso estimado y envíanos una foto clara del material.'],
          ['2', 'Recibe tu cotización del día', 'Te damos el valor por kilo actualizado y confirmamos si requieres recolección.'],
          ['3', 'Pesamos y te pagamos', 'Llévalo a la bodega en la Cra 11 # 23-35 o lo recogemos. Te pagamos de contado al instante.'],
        ].map(([n, t, d]) => (
          <li class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <p class="font-display text-5xl font-extrabold text-copper-500">{n}</p>
            <h3 class="mt-2 text-2xl text-brand-900">{t}</h3>
            <p class="mt-2 text-sm text-ink/80 leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 text-center">
        <a class="btn btn-wa w-full sm:w-auto text-base sm:text-lg text-center" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">Iniciar cotización por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- EMPRESAS (EVERGREEN) -->
  <section class="container-x py-14" aria-labelledby="empresas">
    <div class="grid items-center gap-6 rounded-2xl bg-brand-900 p-6 sm:p-10 text-white border-2 border-copper-500/40 md:grid-cols-[1fr_auto]">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-widest text-copper-400">Atención B2B e Industrial</p>
        <h2 id="empresas" class="mt-1 text-3xl sm:text-4xl">¿Tienes chatarra o maquinaria en tu empresa o taller?</h2>
        <p class="mt-3 max-w-2xl text-white/85 text-base leading-relaxed">
          Compramos excedentes metálicos, retales de obra, tubería y maquinaria en desuso a talleres, constructoras y fábricas en Bucaramanga y área metropolitana. Pago de contado inmediato y logística de transporte.
        </p>
      </div>
      <a class="btn btn-primary w-full md:w-auto text-base text-center" href="/empresas/">Cotizar para mi empresa</a>
    </div>
  </section>

  <!-- BODEGA REAL (solo fotos de instalaciones, sin repetir materiales) -->
  {GALLERY.length > 0 && (
    <section class="container-x pb-14" aria-labelledby="bodega">
      <div class="rounded-3xl border border-brand-100 bg-white p-6 sm:p-8 shadow-sm">
        <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
          <div class="overflow-hidden rounded-2xl border border-brand-100 bg-brand-900 shadow-sm">
            <Image
              src={GALLERY[0].src}
              alt={GALLERY[0].alt}
              widths={[500, 900]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
            />
            <div class="p-3.5 bg-brand-900 text-white flex items-center justify-between text-xs font-semibold">
              <span class="truncate pr-2">{SITE.address.street}</span>
              <span class="text-copper-400 flex-none">{GALLERY[0].label}</span>
            </div>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-copper-500/30 bg-brand-100 px-3 py-1 text-xs font-bold text-brand-700">
              Instalaciones en Bucaramanga
            </span>
            <h2 id="bodega" class="mt-3 text-3xl sm:text-4xl text-brand-900">Nuestra bodega en Carrera 11 # 23-35</h2>
            <p class="mt-3 text-sm sm:text-base text-ink/80 leading-relaxed">
              Bodega amplia acondicionada para pesaje transparente y descargue ágil y seguro de metales, chatarra y baterías.
            </p>
            <ul class="mt-5 space-y-2.5 text-sm font-medium text-ink/90">
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Portón amplio para descargue bajo techo:</strong> Ingreso cómodo de camionetas, camiones y furgones para descargar protegidos de la lluvia.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Báscula electrónica a la vista:</strong> Pesaje exacto verificado frente a ti, sin trucos ni descuentos sorpresa.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-copper-500 font-bold text-base leading-none">✓</span>
                <span><strong>Atención en jornada continua:</strong> Abierto al mediodía de lunes a viernes (7:00 a. m. a 5:30 p. m.) y sábados (7:00 a. m. a 1:30 p. m.).</span>
              </li>
            </ul>
            <div class="mt-6 flex flex-wrap gap-3">
              <a class="btn btn-primary text-sm font-extrabold" href="https://www.google.com/maps/dir/?api=1&destination=Carrera+11+%23+23-35,+Bucaramanga" target="_blank" rel="noopener noreferrer">
                <span>Cómo llegar a la bodega</span>
              </a>
              <a class="btn btn-outline text-sm font-bold" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">
                <span>Avisar llegada por WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- RESEÑAS (solo si hay reseñas reales) -->
  {REVIEWS.length > 0 && (
    <section class="bg-white py-14" aria-labelledby="resenas">
      <div class="container-x">
        <h2 id="resenas" class="text-4xl text-brand-900 sm:text-5xl">Lo que dicen nuestros clientes</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {REVIEWS.map((r) => (
            <figure class="rounded-xl bg-brand-50 p-6"><blockquote class="text-ink/90">{r.text}</blockquote><figcaption class="mt-3 text-sm font-bold text-brand-700">{r.author}{r.date && ` · ${r.date}`}</figcaption></figure>
          ))}
        </div>
        {SITE.gbpUrl && <a class="mt-6 inline-block font-bold text-brand-700 underline" href={SITE.gbpUrl} target="_blank" rel="noopener noreferrer">Ver todas las reseñas en Google</a>}
      </div>
    </section>
  )}

  <!-- UBICACIÓN + FAQ -->
  <section class="container-x grid gap-10 py-14 lg:grid-cols-2" aria-labelledby="ubicacion">
    <div>
      <h2 id="ubicacion" class="text-4xl text-brand-900 sm:text-5xl">Dónde estamos en Bucaramanga</h2>
      <address class="mt-4 not-italic text-lg">
        <p class="font-bold text-brand-900">{SITE.address.street}</p>
        <p class="text-ink/80">{SITE.city}, {SITE.region}</p>
        <div class="mt-4 border-t border-brand-100 pt-3 text-sm">
