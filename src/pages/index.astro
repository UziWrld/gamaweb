---
import Layout from '../layouts/Layout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import FaqList from '../components/FaqList.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { PAGES } from '../data/seo';
import { MATERIALS } from '../data/materials';
import { HOME_FAQS } from '../data/faqs';
import { REVIEWS } from '../data/reviews';
import { GALLERY } from '../data/gallery';
import { waLink, priceListMessage, generalMessage } from '../lib/whatsapp';
import { businessSchema, websiteSchema, faqSchema } from '../lib/schema';

const siteUrl = Astro.site!.origin;
const ticker = ['Cobre de primera', 'Aluminio perfil', 'Chatarra ferrosa', 'Baterías 4D/8D', 'Bronce y llaves', 'Radiadores', 'Acero inoxidable', 'Rines de aluminio', 'Neveras viejas', 'Varilla de obra'];

const clientSegments = [
  {
    title: 'Hogares y particulares',
    desc: 'Neveras, lavadoras, rejas, marcos y cualquier chatarra acumulada en el patio o garaje. Despeja espacio y recibe dinero de inmediato.',
    icon: '🏠',
  },
  {
    title: 'Plomeros y electricistas',
    desc: 'Los mejores precios del kilo en tubería de cobre, cable pelado, cable encauchetado, grifería y llaves de bronce. Pago al instante.',
    icon: '⚡',
  },
  {
    title: 'Talleres mecánicos y montallantas',
    desc: 'Baterías usadas de carro y camión (N40, 4D, 8D), rines de aluminio, radiadores, culatas y discos de freno.',
    icon: '🔧',
  },
  {
    title: 'Constructoras y empresas',
    desc: 'Excedentes metálicos de obras, perfiles, vigas, varilla y maquinaria dada de baja con recolección y logística de cargue incluida.',
    icon: '🏗️',
  },
];
---

<Layout {...PAGES.home} jsonLd={[websiteSchema(siteUrl), businessSchema(siteUrl), faqSchema(HOME_FAQS)]}>
  <!-- HERO -->
  <section class="hero-bg text-white">
    <div class="container-x grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <p class="mb-4 inline-block rounded bg-copper-500 px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-brand-950">
          +{SITE.yearsOfExperience} años de servicio · Pesaje exacto · Pago de contado
        </p>
        <h1 class="text-5xl sm:text-7xl">
          Chatarrería en Bucaramanga: <span class="text-copper-500">compramos tu chatarra y metales al mejor precio</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/90 leading-relaxed">
          Cobre, aluminio, hierro, bronce, baterías y electrodomésticos. <strong>Pesaje transparente frente a ti</strong>, pago inmediato de contado y recolección a domicilio desde {SITE.pickup.minKg} kg.
        </p>
        
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-wa text-lg" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
          <a class="btn btn-ghost text-lg" href="/materiales/">Ver qué compramos</a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm font-semibold text-white/80">
          <span class="flex items-center gap-1.5"><span class="text-copper-500 font-bold">✓</span> Báscula a la vista</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-500 font-bold">✓</span> Efectivo o Nequi al instante</span>
          <span class="flex items-center gap-1.5"><span class="text-copper-500 font-bold">✓</span> Precios actualizados del día</span>
        </div>
      </div>

      <!-- Tarjeta "lista de precios del día" (diferenciador + conversión) -->
      <aside class="rotate-1 rounded-2xl border-4 border-copper-500 bg-brand-900/95 p-6 text-white shadow-2xl border-opacity-100" aria-label="Lista de precios del día">
        <p class="text-xs font-extrabold uppercase tracking-widest text-copper-400">Actualizada todos los días</p>
        <p class="mt-1 font-display text-4xl font-extrabold uppercase text-white">Lista de precios de hoy</p>
        <p class="mt-2 text-sm text-white/80">El valor del kilo cambia a diario en el mercado. Pídela por WhatsApp y te damos el precio exacto en minutos.</p>
        <a class="btn btn-primary mt-5 w-full text-base" href={waLink(priceListMessage())} target="_blank" rel="noopener noreferrer">Pedir precios de hoy por WhatsApp</a>
        <p class="mt-3 text-center text-xs text-white/60">Atención rápida · Lunes a sábado</p>
      </aside>
    </div>

    <!-- Cinta de materiales (CSS puro) -->
    <div class="overflow-hidden border-y border-white/10 bg-brand-900 py-3" aria-hidden="true">
      <div class="ticker-track font-display text-2xl font-bold uppercase tracking-widest text-white/80">
        {[0, 1].map(() => ticker.map((t) => <span class="px-6">{t} <span class="text-copper-500">◆</span></span>))}
      </div>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>

  <!-- PILARES DE CONFIANZA -->
  <section class="container-x py-12" aria-labelledby="garantias">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 id="garantias" class="text-3xl sm:text-4xl text-brand-900">Por qué vender tu material en Gama Metales</h2>
      <p class="mt-2 text-ink/75">Cero enredos, peso justo y la plata en tu mano al instante.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="text-4xl mb-4" aria-hidden="true">⚖️</div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Báscula exacta y a la vista</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          Pesamos cada kilo frente a ti de forma totalmente transparente en nuestra bodega o en el punto de recolección. Cero descuentos raros ni dudas sobre tu peso.
        </p>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="text-4xl mb-4" aria-hidden="true">💵</div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Pago inmediato de contado</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          Plata en mano en cuanto terminamos de pesar: te pagamos en efectivo o por transferencia electrónica inmediata (Nequi, Daviplata o Bancolombia), sin esperas.
        </p>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-white p-7 shadow-sm transition hover:shadow-md">
        <div class="text-4xl mb-4" aria-hidden="true">🚚</div>
        <h3 class="text-2xl text-brand-900 font-extrabold uppercase font-display">Recolección a domicilio (+300 kg)</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">
          No te compliques cargando material pesado. Si tienes 300 kg o más en tu casa, taller u obra en Bucaramanga y el área metropolitana, vamos por él.
        </p>
      </div>
    </div>
  </section>

  <!-- SEGMENTOS DE CLIENTE -->
  <section class="bg-brand-900 py-14 text-white" aria-labelledby="clientes">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="clientes" class="text-3xl sm:text-5xl">Soluciones a tu medida</h2>
        <p class="mt-3 text-white/80">Atendemos desde pequeñas entregas de hogar hasta grandes volúmenes industriales.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {clientSegments.map((c) => (
          <div class="rounded-xl border border-white/15 bg-white/5 p-6 transition hover:bg-white/10">
            <span class="text-3xl" aria-hidden="true">{c.icon}</span>
            <h3 class="mt-3 text-xl font-bold uppercase font-display text-copper-400">{c.title}</h3>
            <p class="mt-2 text-sm text-white/80 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MATERIALES -->
  <section class="container-x py-14" aria-labelledby="materiales">
    <div class="max-w-2xl">
      <h2 id="materiales" class="text-4xl text-brand-900 sm:text-5xl">Qué metales compramos en Bucaramanga</h2>
      <p class="mt-3 text-ink/80">Compramos todo tipo de metales y chatarra. Si tienes dudas con algún material específico, envíanos una foto por WhatsApp y te lo confirmamos en minutos.</p>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {MATERIALS.map((m) => <MaterialCard material={m} level="h3" />)}
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="bg-brand-50 border-y border-brand-100 py-14" aria-labelledby="como">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="como" class="text-4xl text-brand-900 sm:text-5xl">Cómo vender tu chatarra en 3 pasos sencillos</h2>
        <p class="mt-2 text-ink/75">Rápido, transparente y sin complicaciones.</p>
      </div>
      <ol class="grid gap-5 md:grid-cols-3">
        {[
          ['1', 'Escríbenos por WhatsApp', 'Cuéntanos qué metal tienes, el peso estimado y envíanos una foto clara del material.'],
          ['2', 'Recibe tu cotización del día', 'Te damos el valor por kilo actualizado y confirmamos si requieres recolección.'],
          ['3', 'Pesamos y te pagamos', 'Llévalo a la bodega en la Cra 11 # 23-35 o lo recogemos. Te pagamos de contado al instante.'],
        ].map(([n, t, d]) => (
          <li class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <p class="font-display text-5xl font-extrabold text-copper-500">{n}</p>
            <h3 class="mt-2 text-2xl text-brand-900">{t}</h3>
            <p class="mt-2 text-sm text-ink/80 leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 text-center">
        <a class="btn btn-wa text-lg" href={waLink(generalMessage())} target="_blank" rel="noopener noreferrer">Iniciar cotización por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- EMPRESAS (EVERGREEN) -->
  <section class="container-x py-14" aria-labelledby="empresas">
    <div class="grid items-center gap-6 rounded-2xl bg-brand-900 p-8 sm:p-10 text-white border-2 border-copper-500/40 md:grid-cols-[1fr_auto]">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-widest text-copper-400">Atención B2B e Industrial</p>
        <h2 id="empresas" class="mt-1 text-3xl sm:text-4xl">¿Tienes chatarra o maquinaria en tu empresa o taller?</h2>
        <p class="mt-3 max-w-2xl text-white/85 text-base leading-relaxed">
          Compramos excedentes metálicos, retales de obra, tubería y maquinaria en desuso a talleres, constructoras y fábricas en Bucaramanga y área metropolitana. Pago de contado inmediato y logística de transporte.
        </p>
      </div>
      <a class="btn btn-primary text-base whitespace-nowrap" href="/empresas/">Cotizar para mi empresa</a>
    </div>
  </section>

  <!-- GALERÍA (solo si hay fotos) -->
  {GALLERY.length > 0 && (
    <section class="container-x pb-14" aria-labelledby="bodega">
      <h2 id="bodega" class="text-4xl text-brand-900 sm:text-5xl">Nuestra bodega en Bucaramanga</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {GALLERY.map((g) => <Image src={g.src} alt={g.alt} widths={[400, 800]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />)}
      </div>
    </section>
  )}

  <!-- RESEÑAS (solo si hay reseñas reales) -->
  {REVIEWS.length > 0 && (
    <section class="bg-white py-14" aria-labelledby="resenas">
      <div class="container-x">
        <h2 id="resenas" class="text-4xl text-brand-900 sm:text-5xl">Lo que dicen nuestros clientes</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {REVIEWS.map((r) => (
            <figure class="rounded-xl bg-brand-50 p-6"><blockquote class="text-ink/90">{r.text}</blockquote><figcaption class="mt-3 text-sm font-bold text-brand-700">{r.author}{r.date && ` · ${r.date}`}</figcaption></figure>
          ))}
        </div>
        {SITE.gbpUrl && <a class="mt-6 inline-block font-bold text-brand-700 underline" href={SITE.gbpUrl} target="_blank" rel="noopener noreferrer">Ver todas las reseñas en Google</a>}
      </div>
    </section>
  )}

  <!-- UBICACIÓN + FAQ -->
  <section class="container-x grid gap-10 py-14 lg:grid-cols-2" aria-labelledby="ubicacion">
    <div>
      <h2 id="ubicacion" class="text-4xl text-brand-900 sm:text-5xl">Dónde estamos en Bucaramanga</h2>
      <address class="mt-4 not-italic text-lg">
        <p class="font-bold text-brand-900">{SITE.address.street}</p>
        <p class="text-ink/80">{SITE.city}, {SITE.region}</p>
        <p class="text-sm text-ink/70">Plus code: {SITE.address.plusCode}</p>
        <div class="mt-4 border-t border-brand-100 pt-3 text-sm">
          <p class="font-bold text-brand-900">Horario de atención:</p>
          {SITE.hours.map((h) => <p class="mt-0.5 text-ink/80">{h.label}: {h.display}</p>)}
          <p class="mt-1 text-xs text-ink/60">{SITE.closedNote}</p>
        </div>
      </address>
      <a class="btn btn-outline mt-5" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps</a>
    </div>
    <div>
      <h2 class="text-4xl text-brand-900 sm:text-5xl">Preguntas frecuentes</h2>
      <div class="mt-6"><FaqList faqs={HOME_FAQS} /></div>
    </div>
  </section>
</Layout>
