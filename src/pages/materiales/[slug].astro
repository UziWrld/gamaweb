---
import Layout from '../../layouts/Layout.astro';
import FaqList from '../../components/FaqList.astro';
import MaterialCard from '../../components/MaterialCard.astro';
import { Image } from 'astro:assets';
import { MATERIALS } from '../../data/materials';
import { SITE } from '../../data/site';
import { waLink, quoteMessage } from '../../lib/whatsapp';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return MATERIALS.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const siteUrl = Astro.site!.origin;
const related = MATERIALS.filter((x) => x.slug !== m.slug).slice(0, 3);
const ld = [
  breadcrumbSchema(siteUrl, [{ name: 'Materiales', path: '/materiales/' }, { name: m.name, path: `/materiales/${m.slug}/` }]),
  ...(m.faqs?.length ? [faqSchema(m.faqs)] : []),
];
const materialLabel = m.shortName?.toLowerCase() ?? m.name.toLowerCase();
---

<Layout title={m.metaTitle} description={m.metaDescription} jsonLd={ld}>
  <section class="hero-bg text-white">
    <div class="container-x py-12 sm:py-16">
      <nav aria-label="Migas de pan" class="mb-4 text-sm text-white/70">
        <a href="/" class="underline hover:text-white">Inicio</a> / <a href="/materiales/" class="underline hover:text-white">Materiales</a> / {m.name}
      </nav>

      <div class:list={[m.image ? 'grid gap-8 lg:grid-cols-12 lg:items-center' : '']}>
        <div class:list={[m.image ? 'lg:col-span-7' : '']}>
          <p class="mb-3 border-l-2 border-copper-400 pl-3 text-xs font-semibold tracking-wider text-copper-300">
            <span class="uppercase">Símbolo:</span> <strong class="font-bold text-white">{m.symbol}</strong>
            {m.number && <span> · Ref. {m.number}</span>}
          </p>
          <h1 class="max-w-4xl text-4xl sm:text-5xl lg:text-6xl font-extrabold">{m.h1}</h1>
          <p class="mt-4 max-w-2xl text-lg text-white/85 leading-relaxed">{m.intro}</p>
          <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
            <a class="btn btn-wa w-full sm:w-auto text-base sm:text-lg text-center" href={waLink(quoteMessage({ material: m.name }))} target="_blank" rel="noopener noreferrer">
              Cotizar {materialLabel} ahora
            </a>
            <a class="btn btn-ghost w-full sm:w-auto text-base sm:text-lg text-center" href={waLink(quoteMessage({ material: m.name, pickup: true }))} target="_blank" rel="noopener noreferrer">
              Pedir recolección (+300 kg)
            </a>
          </div>
        </div>

        {m.image && (
          <div class="lg:col-span-5">
            <div class="overflow-hidden rounded-2xl border border-white/20 bg-black/40 shadow-2xl backdrop-blur-sm">
              <Image
                src={m.image}
                alt={m.imageAlt || `Lote de ${m.name} recibido en Gama Metales`}
                widths={[400, 700]}
                sizes="(min-width: 1024px) 40vw, 100vw"
                class="aspect-[4/3] w-full object-cover"
                loading="eager"
              />
              <div class="p-3 bg-brand-950/90 text-white flex items-center justify-between text-xs font-semibold border-t border-white/10">
                <span>{SITE.address.street} · {SITE.city}</span>
                <span class="text-copper-400">Cotización del día</span>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>

  <!-- Qué compramos + Qué mueve el precio -->
  <div class="container-x grid gap-10 py-12 lg:grid-cols-2">
    <section aria-labelledby="que">
      <h2 id="que" class="text-4xl text-brand-900">Qué tipos de {m.name.toLowerCase()} compramos</h2>
      <ul class="mt-5 grid gap-2.5">
        {m.items.map((i) => (
          <li class="rounded-lg border border-brand-100 bg-white p-3.5 font-semibold shadow-sm flex items-start gap-2.5">
            <span class="text-copper-500 font-bold" aria-hidden="true">✓</span>
            <span>{i}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="precio">
      <h2 id="precio" class="text-4xl text-brand-900">Qué mueve el precio del {materialLabel}</h2>
      <p class="mt-3 text-sm text-ink/75">El valor por kilo cambia cada jornada según el mercado y el estado en que llega el lote:</p>
      <ul class="mt-4 grid gap-3">
        {m.priceDrivers.map((driver) => (
          <li class="rounded-xl border border-brand-100 bg-white p-4 text-sm text-ink/85 leading-relaxed shadow-sm">
            {driver}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <!-- Cómo preparar el material -->
  <section class="bg-brand-50 border-y border-brand-100 py-12" aria-labelledby="preparar">
    <div class="container-x">
      <div class="max-w-2xl">
        <h2 id="preparar" class="text-4xl text-brand-900">Cómo preparar tu {materialLabel} antes de venderlo</h2>
        <p class="mt-2 text-ink/75">Pequeños cuidados al separar y limpiar el material evitan descuentos por impurezas y mejoran la clasificación.</p>
      </div>
      <ol class="mt-7 grid gap-5 sm:grid-cols-2">
        {m.prepSteps.map((step, idx) => (
          <li class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <p class="font-display text-3xl font-extrabold text-copper-500">0{idx + 1}</p>
            <h3 class="mt-1 text-2xl text-brand-900">{step.title}</h3>
            <p class="mt-2 text-sm text-ink/80 leading-relaxed">{step.detail}</p>
          </li>
        ))}
      </ol>

      {m.tips.length > 0 && (
        <div class="mt-8 rounded-2xl border border-brand-200 bg-white p-6">
          <h3 class="text-2xl text-brand-900">Recomendaciones prácticas en bodega</h3>
          <ul class="mt-4 grid gap-3 md:grid-cols-3">
            {m.tips.map((t) => (
              <li class="rounded-lg border-l-4 border-copper-500 bg-brand-50 p-4 text-sm text-ink/85">{t}</li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-brand-100 pt-5">
            <p class="text-sm text-ink/80 max-w-xl">
              ¿Tienes dudas sobre cómo clasificar tu lote? Mándanos una foto por WhatsApp o acércate a {SITE.address.street}, {SITE.city}.
            </p>
            <a class="btn btn-wa text-sm font-extrabold" href={waLink(quoteMessage({ material: m.name }))} target="_blank" rel="noopener noreferrer">
              Enviar foto por WhatsApp
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Galería adicional por material (se renderiza cuando haya más fotos reales en materials.ts) -->
  {m.gallery && m.gallery.length > 0 && (
    <section class="container-x pt-12" aria-labelledby="galeria-material">
      <h2 id="galeria-material" class="text-4xl text-brand-900">Fotos de referencia en bodega</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {m.gallery.map((g) => (
          <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <Image
              src={g.src}
              alt={g.alt}
              widths={[400, 700]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
            />
            {g.caption && <figcaption class="p-3 text-xs font-semibold text-ink/80">{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {m.faqs && m.faqs.length > 0 && (
    <section class="container-x py-12" aria-labelledby="faq">
      <h2 id="faq" class="text-4xl text-brand-900">Preguntas frecuentes sobre {m.name.toLowerCase()}</h2>
      <div class="mt-6 max-w-3xl"><FaqList faqs={m.faqs} /></div>
    </section>
  )}

  <section class="container-x pb-14" aria-labelledby="otros">
    <h2 id="otros" class="text-4xl text-brand-900">También compramos</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">{related.map((r) => <MaterialCard material={r} level="h3" />)}</div>
  </section>
</Layout>
