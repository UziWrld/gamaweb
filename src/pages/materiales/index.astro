---
import Layout from '../../layouts/Layout.astro';
import MaterialCard from '../../components/MaterialCard.astro';
import OtherMaterialCard from '../../components/OtherMaterialCard.astro';
import { PAGES } from '../../data/seo';
import { MATERIALS } from '../../data/materials';
import { waLink, priceListMessage } from '../../lib/whatsapp';
import { breadcrumbSchema } from '../../lib/schema';
const siteUrl = Astro.site!.origin;
---

<Layout {...PAGES.materiales} jsonLd={[breadcrumbSchema(siteUrl, [{ name: 'Materiales', path: '/materiales/' }])]}>
  <section class="hero-bg text-white">
    <div class="container-x py-14 sm:py-20">
      <h1 class="max-w-4xl text-5xl sm:text-6xl">Compra de metales y chatarra en <span class="text-copper-500">Bucaramanga</span></h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">Compramos cobre, bronce, aluminio, hierro, acero, baterías y electrodomésticos. Consulta la cotización actualizada del día por WhatsApp y elige entrega en bodega o recolección.</p>
      <a class="btn btn-wa mt-7 w-full sm:w-auto text-base sm:text-lg font-extrabold text-center" href={waLink(priceListMessage())} target="_blank" rel="noopener noreferrer">Cotizar mi material por WhatsApp</a>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>

  <section class="container-x py-12 pb-16" aria-labelledby="lista">
    <h2 id="lista" class="text-4xl text-brand-900">Materiales que recibimos</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {MATERIALS.map((m) => <MaterialCard material={m} level="h3" />)}
      <OtherMaterialCard level="h3" />
    </div>
  </section>
</Layout>
