---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const props = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...props} />
  </head>
  <body class="pb-20 sm:pb-0">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-copper-500 focus:px-4 focus:py-2 focus:font-bold focus:text-brand-950">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsAppFloat />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[data-route-link]');
        if (!link) return;
        var ua = navigator.userAgent || '';
        if (/android/i.test(ua)) {
          e.preventDefault();
          window.location.href = 'geo:0,0?q=Carrera+11+%23+23-35,+Bucaramanga';
        } else if (/iphone|ipad|ipod/i.test(ua)) {
          e.preventDefault();
          window.location.href = 'https://maps.apple.com/?daddr=Carrera+11+%23+23-35,+Bucaramanga&dirflg=d';
        }
      });
    </script>
  </body>
</html>

